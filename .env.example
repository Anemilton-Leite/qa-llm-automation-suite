# Copie este arquivo para .env e preencha com suas chaves
# NUNCA commite o arquivo .env — ele já está no .gitignore

# URL base da aplicação LLM testada
BASE_URL=https://claude.ai

# Chave de API do provider LLM (OpenAI, OpenRouter, Anthropic, etc.)
LLM_API_KEY=sk-your-api-key-here

# Provider e modelo padrão
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini

# Timeout para respostas de LLM (ms) — modelos podem ser lentos
LLM_RESPONSE_TIMEOUT=30000
